# ClassSphere 2.0 Configuration Register
# Location: backend/.env

# Application Mode: SIMULATION or CONNECTED
APP_MODE=SIMULATION

# Database Connection (PostgreSQL production URL or SQLite local async)
# Production: postgresql+asyncpg://postgres:password@localhost:5432/classsphere
# Local dev default: sqlite+aiosqlite:///./classsphere.db
DATABASE_URL=sqlite+aiosqlite:///./classsphere.db

# JWT & Security
JWT_SECRET_KEY=classsphere-super-secure-production-jwt-secret-key-32-chars-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Twilio Verify Service (FR-01)
# When unset or in SIMULATION mode, a secure dev verification flow is used.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Computer Vision Model Weights Paths (FR-04, FR-08, FR-13, FR-17)
# Unselected models must be marked PENDING EVALUATION
YOLO_MODEL_PATH=models/yolov8n.pt
FACE_MODEL_PATH=PENDING EVALUATION
ACTIVITY_MODEL_PATH=PENDING EVALUATION
FALL_MODEL_PATH=PENDING EVALUATION

# Camera Source Configuration
# Default simulation stream or RTSP/CCTV URL for CONNECTED mode
CAMERA_SOURCE=simulated://classroom_a101

# Real-time and Notification Provider
NOTIFICATION_PROVIDER=websocket

# CORS Origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
